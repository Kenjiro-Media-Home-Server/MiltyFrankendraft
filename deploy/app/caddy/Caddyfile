(common_config) {
    root * /code

    log {
        output stdout
    }

    header {
       X-Frame-Options DENY
       Referrer-Policy no-referrer-when-downgrade
       Access-Control-Allow-Origin *
   }

    @options method OPTIONS

    @svg {
         file
         path *.svg
     }

    header @svg Content-Security-Policy "script-src 'none'"

    # The application is served straight out of the repository root, so without this everything
    # in it is downloadable: the .env file, the git history, the source, and — worst — the draft
    # JSON files, which contain every draft's admin passkey and each player's passkey.
    # data/ is only ever read server-side by PHP, never fetched by the browser.
    @blocked {
        path /.env /.env.* /.git /.git/* /.gitignore /.htaccess /.dockerignore
        path /.php-cs-fixer.php /.php-cs-fixer.cache /.github /.github/*
        path /app /app/* /bin /bin/* /data /data/* /deploy /deploy/*
        path /docs /docs/* /tmp /tmp/* /vendor /vendor/* /node_modules /node_modules/*
        path /composer.json /composer.lock /phpunit.xml /phpstan.neon /package.json /package-lock.json
        path *.md *.scss *.map *.yml *.yaml *.lock *.dist *.sh
    }

    # An explicit route so the deny is evaluated before the file server and PHP get a chance;
    # outside a route block Caddy's own directive order would run file_server first.
    route {
        respond @options 204
        respond @blocked 404
        php_fastcgi localhost:9000
        file_server
    }

    encode zstd gzip

    tls internal
}

:80 {
    import common_config
}
milty.localhost {
    import common_config
}
