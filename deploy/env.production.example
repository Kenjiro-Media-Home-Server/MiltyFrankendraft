# Production settings for the Franken/Milty draft app.
# Copy to .env next to docker-compose.prod.yml and fill in. Mind the trailing slash on URL.

# Public address the app is served from. Every link and asset URL is built from this, so it must
# match exactly how visitors reach it, including the path if it is served under one.
URL="https://example.org/"

# "local" keeps drafts as JSON files; "spaces" uploads them to S3/DigitalOcean Spaces.
STORAGE="local"

# Must be the in-container path of the drafts volume, outside the web root.
STORAGE_PATH="/srv/drafts"

# Only needed when STORAGE="spaces".
ACCESS_KEY=""
ACCESS_SECRET=""
BUCKET=""
REGION=""

# Bumped on each deploy; used to bust browser caches for css/js.
VERSION="1.0.0"

# Never true in production: it prints exception messages to visitors.
DEBUG=false

# Host port the container binds on loopback for the reverse proxy to reach.
APP_PORT=8091
